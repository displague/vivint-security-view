{
  "name": "vivint-security-view",
  "version": "0.0.0-development",
  "private": true,
  "description": "Home-network viewer and always-on HLS ingest for a Vivint panel, with an optional Google Smart Home bridge.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "refresh:vivint": "node scripts/refresh_vivint_rtsp_urls.js",
    "release": "semantic-release",
    "lint:commits": "commitlint --from origin/main --to HEAD"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "fs-extra": "^11.3.2",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9"
  },
  "license": "MIT"
}
